<?xml version="1.0" encoding="UTF-8" ?>
<pbj-schema xmlns="http://gdbots.io/pbj/xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://gdbots.io/pbj/xsd http://gdbots.io/pbj/xsd/schema.xsd">

  <schema id="pbj:tmz:people:node:person:1-0-1">
    <fields>
      <field name="is_author" type="boolean">
        <description>
          When true, this person is a TMZ author and can be associated with articles.
        </description>
      </field>
      <field name="job_title" type="string"/>
      <field name="facebook_username" type="string" pattern="^[\w\.]{1,50}$"/>
      <field name="tiktok_username" type="string" pattern="^[\w\.]{1,24}$"/>
    </fields>

    <mixins>
      <curie-major>gdbots:ncr:mixin:node:v1</curie-major>
      <curie-major>triniti:people:mixin:person:v1</curie-major>
      <curie-major>gdbots:common:mixin:taggable:v1</curie-major>
      <curie-major>gdbots:ncr:mixin:sluggable:v1</curie-major>
      <curie-major>triniti:canvas:mixin:has-blocks:v1</curie-major>
      <curie-major>triniti:common:mixin:advertising:v1</curie-major>
      <curie-major>triniti:common:mixin:seo:v1</curie-major>
      <curie-major>triniti:common:mixin:themeable:v1</curie-major>
      <curie-major>triniti:curator:mixin:teaserable:v1</curie-major>
      <curie-major>triniti:taxonomy:mixin:hashtaggable:v1</curie-major>
    </mixins>
  </schema>
</pbj-schema>
