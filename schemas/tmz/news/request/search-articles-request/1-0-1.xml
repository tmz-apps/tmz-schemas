<?xml version="1.0" encoding="UTF-8" ?>
<pbj-schema xmlns="http://gdbots.io/pbj/xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://gdbots.io/pbj/xsd http://gdbots.io/pbj/xsd/schema.xsd">

  <schema id="pbj:tmz:news:request:search-articles-request:1-0-1">
    <fields>
      <field name="author_refs" type="node-ref" rule="set">
        <description>
          Filter articles that include any of these authors. Order is not significant on search.
        </description>
      </field>
    </fields>

    <mixins>
      <curie-major>gdbots:pbjx:mixin:request:v1</curie-major>
      <curie-major>gdbots:ncr:mixin:search-nodes-request:v1</curie-major>
      <curie-major>triniti:news:mixin:search-articles-request:v1</curie-major>
      <curie-major>triniti:curator:mixin:widget-search-request:v1</curie-major>
      <curie-major>tmz:canvas:mixin:block-search-request:v1</curie-major>
    </mixins>
  </schema>
</pbj-schema>
